# Ollama AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=jarvis-ft:latest
OLLAMA_TIMEOUT=15.0

# Speech & Voice Settings
WAKE_WORDS=jarvis,hey jarvis
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=-10%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# Audio Processing & Dynamic VAD
SAMPLE_RATE=16000
VAD_ENERGY_THRESHOLD=0.010
VAD_SILENCE_TIMEOUT=0.7
MAX_COMMAND_SECONDS=8.0
