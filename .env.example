# Sora AI Configuration
# Copy this file to .env. All processing remains local except the optional
# Google SpeechRecognition and Edge-TTS fallbacks used by the legacy pipeline.

# Ollama Local AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL= "jarvis-ft:latest"
OLLAMA_TIMEOUT=30

# Wake Word(s) comma-separated (e.g. sora, hey sora)
WAKE_WORDS=aegis,hey sora

# Cinematic British assistant or neutral. Individual settings may override it.
TTS_PROFILE=cinematic_assistant
TTS_VOICE=
TTS_RATE=
TTS_PITCH=
TTS_VOLUME=

# Audio Settings
SAMPLE_RATE=16000
MIC_ENERGY_THRESHOLD=280

# App Settings
DEBUG=False
LOG_LEVEL=INFO
VAD_ENERGY_THRESHOLD=0.010
VAD_SILENCE_TIMEOUT=0.7
MAX_COMMAND_SECONDS=8
CONFIRMATION_TIMEOUT=20
TOOL_TIMEOUT=15
# Custom aliases: name=full_path;another_name=full_path
SORA_APP_ALIASES=
