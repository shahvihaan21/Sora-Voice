# Sora AI Configuration
 
# Ollama Local AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Wake Word(s) comma-separated (e.g. sora, hey sora)
WAKE_WORDS=sora,hey sora

# Cinematic British assistant or neutral. Individual settings may override it.
TTS_PROFILE=cinematic_assistant
TTS_VOICE=
TTS_RATE=
TTS_PITCH=
TTS_VOLUME=

# Audio Settings
SAMPLE_RATE=16000
MIC_ENERGY_THRESHOLD=280

# App Settings
DEBUG=True
