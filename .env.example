# Sora AI Configuration
 
# Ollama Local AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Wake Word(s) comma-separated (e.g. sora, hey sora)
WAKE_WORDS=sora,hey sora

# TTS Voice (Microsoft Edge TTS voices, e.g. en-US-AriaNeural, en-US-JennyNeural, en-GB-SoniaNeural)
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+15%

# Audio Settings
SAMPLE_RATE=16000
MIC_ENERGY_THRESHOLD=280

# App Settings
DEBUG=True
